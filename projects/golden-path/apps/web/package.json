{
  "name": "@safrs/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev:email": "email dev --dir src/email",
    "lint": "biome check src",
    "start": "next start",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:update": "playwright test --config playwright.config.ts --update-snapshots",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "@safrs/api": "workspace:*",
    "@safrs/database": "workspace:*",
    "@safrs/env": "workspace:*",
    "@safrs/telemetry": "workspace:*",
    "@safrs/ui": "workspace:*",
    "@sentra/token": "workspace:*",
    "hono": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "catalog:",
    "stripe": "catalog:"
  },
  "devDependencies": {
    "@safrs/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@react-email/ui": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-email": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
