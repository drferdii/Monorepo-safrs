generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

model Demo {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  transactions TransactionSample[]

  @@map("demos")
}

model TransactionSample {
  id         BigInt   @id @default(autoincrement())
  demoId     String   @map("demo_id") @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @db.Char(3)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  demo       Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId], map: "transaction_samples_demo_id_idx")
  @@map("transaction_samples")
}
